{
  "name": "ucoder-insight",
  "version": "1.1.3",
  "sideEffects": false,
  "description": "A privacy-first, cookie-free, and lightweight web analytics SDK for React, Next.js, Vanilla JavaScript, and SPA applications. Developer-friendly and easy to integrate.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.mjs",
  "browser": "dist/index.global.js",
  "unpkg": "dist/index.global.js",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./global": "./dist/index.global.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm,iife --dts --clean --treeshake --minify --global-name UcoderInsight",
    "dev": "tsup src/index.ts --watch",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "analytics",
    "web-analytics",
    "tracking",
    "react-analytics",
    "nextjs-analytics",
    "privacy-first",
    "cookie-free",
    "events-tracker",
    "performance-monitoring",
    "web-vitals",
    "spa-analytics",
    "sdk",
    "ucoder",
    "ucoder-insight"
  ],
  "author": "Ucoder",
  "license": "MIT",
  "peerDependencies": {
    "web-vitals": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "web-vitals": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.10.15",
    "@vitest/ui": "^4.1.8",
    "happy-dom": "^20.10.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8",
    "web-vitals": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soumydip/ucoder_insight_core.git"
  },
  "bugs": {
    "url": "https://github.com/soumydip/ucoder_insight_core/issues"
  },
  "homepage": "https://github.com/soumydip/ucoder_insight_core#readme"
}
